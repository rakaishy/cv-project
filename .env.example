# Copy this file to .env.local and configure ONE provider.
#
#   cp .env.example .env.local
#
# The chat route (src/app/api/chat/route.ts) reads these at request time.
# With no API key set, /api/chat responds with 503 instead of calling a provider.

# --- OpenAI (default) ---
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-your-key-here

# --- Ollama (local, no API key needed) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# --- llama.cpp (local, no API key needed) ---
# AI_BASE_URL=http://localhost:8080/v1
# AI_MODEL=llama-3.2-3b-instruct
